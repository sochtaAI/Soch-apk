# SOCH Environment Configuration

# Supabase Authentication & Database credentials
# Configure in Secrets panel or .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key-placeholder

# GEMINI_API_KEY / AI_API_KEY: Required for SOCH AI Assistant
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=your-ai-api-key-here

